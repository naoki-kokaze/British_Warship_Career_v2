#################################################################
#    v2 additions (2026-09-30, draft.1): production and first cost
#    Design notes: phd_thesis/jinmoncom2026/docs/jinmoncom2026_rules_v0_header_report_20260930.md §5
#################################################################

# (draft.2: the CIDOC declarations formerly here — E4, P9, P17, P108 — moved to the CIDOC sections above,
#  with the official domains/ranges.)

crm:E12_Production rdfs:comment "v2: the time-span begins with the keel laying (K:) and ends with the first completion (C:). A missing date is left empty in the record layer; no substitution (e.g. launch date for completion) is made there."@en .

# --- Events around production ---
:Ordering a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "Ordering"@en ;
    rdfs:comment "The Admiralty order to build the ship (Winfield 'Ord:'). Not part of the production; linked from crm:E12_Production by crm:P17_was_motivated_by."@en .

:Reordering a owl:Class ;
    rdfs:subClassOf :Ordering ;
    rdfs:label "Re-ordering"@en ;
    rdfs:comment "A renewed order, e.g. to a new design (Winfield 'Re-ord:')."@en .

:Launching a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "Launching"@en ;
    rdfs:comment "The launch or floating out of the hull (Winfield 'L:'). Part of crm:E12_Production (crm:P9_consists_of). Its date is the basis of ship age in the event history analysis."@en .

:Fitting a owl:Class ;
    rdfs:subClassOf crm:E11_Modification ;
    rdfs:label "Fitting"@en ;
    rdfs:comment "v2: generic fitting-out (v1 used this class 157 times without declaring it)."@en .

:FittingForOrdinary a owl:Class ;
    rdfs:subClassOf :Fitting ;
    rdfs:label "Fitting for Ordinary"@en ;
    rdfs:comment "Fitting-out to lay the ship up in Ordinary (Winfield 'for Ordinary')."@en .

:Completion a owl:Class ;
    rdfs:subClassOf :Fitting ;
    rdfs:label "Completion"@en ;
    rdfs:comment "The first completion (Winfield 'C:'), which ends crm:E12_Production and is part of it (crm:P9_consists_of). A single date or a period of fitting-out. Later 'C:' entries are recorded as :Fitting (or its subclasses), not as :Completion. May also be typed :FittingForSea or :FittingForOrdinary according to its stated purpose."@en .

# --- First cost ---
:CostComponent a owl:Class ;
    rdfs:subClassOf crm:E55_Type ;
    rdfs:comment "Kind of an amount in the first cost, as stated in the source. Sums are not recorded unless the source states a total; totals are computed in the analysis layer."@en .

:HullCost a owl:NamedIndividual , :CostComponent ; rdfs:label "hull"@en .
:MachineryCost a owl:NamedIndividual , :CostComponent ; rdfs:label "machinery"@en .
:FittingCost a owl:NamedIndividual , :CostComponent ; rdfs:label "fitting"@en .
:BuildCost a owl:NamedIndividual , :CostComponent ; rdfs:label "building (to builder / contractor)"@en .
:SuppliesCost a owl:NamedIndividual , :CostComponent ; rdfs:label "Admiralty supplies"@en .
:StatedTotalCost a owl:NamedIndividual , :CostComponent ; rdfs:label "total, as stated in the source"@en .
:UnspecifiedCost a owl:NamedIndividual , :CostComponent ; rdfs:label "kind not stated or not recognised by the rules"@en .

# --- Provenance of deterministic conversion ---
:generated_by_rule a owl:AnnotationProperty ;
    rdfs:comment "Space-separated IDs of the deterministic rules that produced this node (see the rule list in scripts/extract_header_v0.py). Nodes produced by an LLM carry a different marker."@en .

:source_text a owl:AnnotationProperty ;
    rdfs:comment "The source string (Winfield, after the OCR normalisation rules) from which this node was produced."@en .

#################################################################
#    v2 additions (2026-10-05, draft.2): dimensions and tonnage (for rules v0.1)
#    Definitions from Winfield 2014, 'Glossary and Abbreviations', entries 'Dimensions' and 'Tons'
#    (checked against the page images of phd_thesis/sources/prev_works/Winfield_1_firstRate.pdf, PDF pp. 2, 4).
#    Units and the numeric form of values (feet and inches, ninety-fourths of a ton) are decided with rules v0.1.
#    Not yet defined (not in the glossary): 'oa' attached to a breadth, 'disp.' (displacement), and entries with
#    four values separated by 'x'; their handling is decided and recorded with rules v0.1.
#################################################################

:DimensionKind a owl:Class ;
    rdfs:subClassOf crm:E55_Type ;
    rdfs:label "Kind of dimension"@en ;
    rdfs:comment "Kind of a crm:E54_Dimension observed in a crm:E16_Measurement (value of crm:P2_has_type on the dimension)."@en .

:GundeckLength a owl:NamedIndividual , :DimensionKind ;
    rdfs:label "length on the gundeck"@en ;
    rdfs:comment "Definition not reproduced here for copyright reasons; see Winfield 2014, Glossary and Abbreviations."@en ;
    dcterms:source "Winfield 2014, Glossary and Abbreviations, s.v. 'Dimensions' (Length)."@en .

:KeelLengthForTonnage a owl:NamedIndividual , :DimensionKind ;
    rdfs:label "length of the keel for tonnage"@en ;
    rdfs:comment "Definition not reproduced here for copyright reasons; see Winfield 2014, Glossary and Abbreviations."@en ;
    dcterms:source "Winfield 2014, Glossary and Abbreviations, s.v. 'Dimensions' (Length)."@en .

:BreadthForTonnage a owl:NamedIndividual , :DimensionKind ;
    rdfs:label "breadth for tonnage"@en ;
    rdfs:comment "Definition not reproduced here for copyright reasons; see Winfield 2014, Glossary and Abbreviations."@en ;
    dcterms:source "Winfield 2014, Glossary and Abbreviations, s.v. 'Dimensions' (Breadth)."@en .

:DepthInHold a owl:NamedIndividual , :DimensionKind ;
    rdfs:label "depth in hold"@en ;
    rdfs:comment "Definition not reproduced here for copyright reasons; see Winfield 2014, Glossary and Abbreviations."@en ;
    dcterms:source "Winfield 2014, Glossary and Abbreviations, s.v. 'Dimensions' (Depth)."@en .

:DraughtForward a owl:NamedIndividual , :DimensionKind ;
    rdfs:label "draught forward (light, at completion)"@en ;
    rdfs:comment "The first value of 'Draught forwards/aft': the light draught at the ship's completion; fully laden the ship drew considerably more."@en ;
    dcterms:source "Winfield 2014, Glossary and Abbreviations, s.v. 'Dimensions' (Draught)."@en .

:DraughtAft a owl:NamedIndividual , :DimensionKind ;
    rdfs:label "draught aft (light, at completion)"@en ;
    rdfs:comment "The second value of 'Draught forwards/aft': the light draught at the ship's completion."@en ;
    dcterms:source "Winfield 2014, Glossary and Abbreviations, s.v. 'Dimensions' (Draught)."@en .

:BuildersMeasurement a owl:NamedIndividual , :DimensionKind ;
    rdfs:label "tons Builder's Measurement (bm)"@en ;
    rdfs:comment "Tonnage by Builder's Measurement, k x b x (b/2) / 94 with k the keel length for tonnage and b the breadth for tonnage; hence fractions in ninety-fourths. A measure of volume (capacity of the hull), not of weight; displacement is a later introduction."@en ;
    dcterms:source "Winfield 2014, Glossary and Abbreviations, s.v. 'Tons'."@en .

# --- draft.2 (2026-10-05, rules v0.1): kinds outside the glossary's four dimensions ---
:MouldedBreadth a owl:NamedIndividual , :DimensionKind ;
    rdfs:label "moulded breadth"@en ;
    rdfs:comment "Breadth marked 'mid.' (moulded) in the source, e.g. '39ft 7in (39ft 0in mid)'."@en ;
    dcterms:source "Winfield 2014, Glossary and Abbreviations, s.v. 'Mld.'"@en .

:BreadthMarkedOA a owl:NamedIndividual , :DimensionKind ;
    rdfs:label "breadth marked 'oa'"@en ;
    rdfs:comment "A breadth the source marks 'oa', usually beside a breadth 'for tonnage' (e.g. '37ft 6in oa (37ft 0in for tonnage)'). 'oa' is not defined in the glossary; presumably overall (extreme) breadth, but this is not asserted in the record layer."@en .

:BreadthUnlabelled a owl:NamedIndividual , :DimensionKind ;
    rdfs:label "breadth, kind not stated"@en ;
    rdfs:comment "A second breadth given without a label (e.g. the outer value of '24ft 8¼in (24ft 6¼in for tons)', or a value in parentheses without a word). Its kind is not stated in the source."@en .

:LengthUnspecified a owl:NamedIndividual , :DimensionKind ;
    rdfs:label "length, kind not stated"@en ;
    rdfs:comment "Only one length is given, so whether it is the length on the gundeck or the keel length for tonnage is not stated."@en .

:Displacement a owl:NamedIndividual , :DimensionKind ;
    rdfs:label "displacement (tons)"@en ;
    rdfs:comment "Displacement tonnage (weight), e.g. '1,960 disp.'. Not the Builder's Measurement."@en ;
    dcterms:source "Winfield 2014, Glossary and Abbreviations, s.v. 'Tons' (displacement tonnages 'are given herein for reference purposes for later steam vessels')."@en .

# --- occasions of a measurement (the heading in the source) ---
:MeasurementOccasion a owl:Class ;
    rdfs:subClassOf crm:E55_Type ;
    rdfs:comment "The heading under which Winfield gives the dimensions (value of crm:P2_has_type on a crm:E16_Measurement)."@en .
:AsBuilt a owl:NamedIndividual , :MeasurementOccasion ; rdfs:label "As built"@en ;
    rdfs:comment "Actual measured dimensions of the individual vessel; for an acquired vessel, as measured upon its acquisition (Glossary, 'Dimensions')."@en .
:DimensionsAndTons a owl:NamedIndividual , :MeasurementOccasion ; rdfs:label "Dimensions & tons"@en ;
    rdfs:comment "Heading mostly used for purchased or captured vessels. The time of measurement is not stated."@en .
:AsCompleted a owl:NamedIndividual , :MeasurementOccasion ; rdfs:label "Tonnage as completed"@en .
:AsLengthened a owl:NamedIndividual , :MeasurementOccasion ; rdfs:label "As lengthened"@en .
:AsConverted a owl:NamedIndividual , :MeasurementOccasion ; rdfs:label "As converted"@en .

# --- record-layer values of a dimension (decision 2026-10-05: feet and inches kept separately) ---
:value_feet a owl:DatatypeProperty ;
    rdfs:domain crm:E54_Dimension ;
    rdfs:range xsd:integer ;
    rdfs:comment "Feet part of a length as written in the source. Feet and inches are recorded separately in the record layer; conversion (e.g. to decimal feet) is done in the analysis layer."@en .

:value_inches a owl:DatatypeProperty ;
    rdfs:domain crm:E54_Dimension ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Inches part of a length, with fractions as decimals (½ = 0.5, ⅛ = 0.125). Less than 12."@en .

:tons_bm_whole a owl:DatatypeProperty ;
    rdfs:domain crm:E54_Dimension ;
    rdfs:range xsd:integer ;
    rdfs:comment "Whole tons of a Builder's Measurement."@en .

:tons_bm_ninety_fourths a owl:DatatypeProperty ;
    rdfs:domain crm:E54_Dimension ;
    rdfs:range xsd:integer ;
    rdfs:comment "Numerator of the fraction of a ton in ninety-fourths (0-93). Absent when the source's fraction is unreadable."@en .

:value_status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "How the value was obtained: 'parsed' (rules read the source as written, possibly after a unique OCR repair), 'formula_resolved' (rule F2: an unclear OCR reading chosen by the Builder's Measurement formula; to be checked against the page image), 'visually_confirmed', 'visually_corrected' (checked against the page image by a person), 'needs_review' (not determined; only the readable part is recorded)."@en .

:DimensionUnlabelled a owl:NamedIndividual , :DimensionKind ;
    rdfs:label "dimension, kind not stated"@en ;
    rdfs:comment "Definition not reproduced here for copyright reasons; see Winfield 2014, Glossary and Abbreviations."@en .

# --- draft.2 (2026-10-05): kinds of transfer of custody (decision F', decisions memo §5) ---
:CustodyTransferType a owl:Class ;
    rdfs:subClassOf crm:E55_Type ;
    rdfs:comment "Kind of a crm:E10_Transfer_of_Custody (value of crm:P2_has_type), as the scope note of E10 recommends for distinguishing kinds of transfer. CIDOC CRM has no class or property for loans; it models legal ownership (crm:E8_Acquisition) and physical custody (crm:E10_Transfer_of_Custody) separately."@en .
:Loan a owl:NamedIndividual , :CustodyTransferType ;
    rdfs:label "loan"@en ;
    rdfs:comment "Winfield 'lent to ...': custody passes, ownership stays with the Navy. No crm:E8_Acquisition is recorded."@en .
:Transfer a owl:NamedIndividual , :CustodyTransferType ;
    rdfs:label "transfer"@en ;
    rdfs:comment "Winfield 'transferred to ...' (mostly to another government department, i.e. within Crown property). Recorded as a transfer of custody; a crm:E8_Acquisition is added only when the source makes a change of owner explicit (e.g. sale, gift)."@en .

# --- draft.2 (2026-10-05, rules v1): command appointment (decision B1) ---
:BreakingUpOrder a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "Order to break up"@en ;
    rdfs:comment "v2 (rules v1, 2026-10-07): the Admiralty Order to break a ship up ('BU (by AO 23.5.1871) completed 3.3.1875'). The date of the order is not the date of the breaking up; the breaking up (crm:E6_Destruction) is linked to the order by crm:P17_was_motivated_by, as the production is linked to its :Ordering. When the source gives only the completion, the breaking up has an end and no beginning."@en .

:SaleOrder a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "Order to sell"@en ;
    rdfs:comment "v2 (rules v1, round 2, 2026-10-07): the Admiralty Order to sell a ship ('Sold (by AO 20.4.1827) at Bombay ... 6.4.1829'). The date of the order is not the date of the sale; the sale (crm:E96_Purchase) is linked to the order by crm:P17_was_motivated_by, as the breaking up is linked to its :BreakingUpOrder. When the source gives only the order ('Sold by AO 27.7.1847'), the sale has no date."@en .

:CommandAppointment a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "Command appointment"@en ;
    rdfs:comment "An officer taking command of the ship, as stated in the source ('On 1.7.1865 under Capt. ...', 'then 7.1.1881 under Capt. ...'). Recorded as written; it does not change the service status, and no commissioning is inferred from it, even after paying off (decision B1, 2026-10-05). The officer's name is kept as text (:officer_text); persons are not identified."@en .

:review_note a owl:DatatypeProperty ;
    rdfs:label "review note"@en ;
    rdfs:comment "v2 (2026-10-07): why a node needs to be checked against the source by a person (adjudication of v1 and v2, §11.5): an event the rules could not read fully, a Presence derived by rule B1r (F2), a status assumed to continue through a long silence of the source (F1, rule P2), a name possibly garbled by OCR. The value is a short explanation; the node itself is not changed."@en .

:officer_text a owl:DatatypeProperty ;
    rdfs:domain :CommandAppointment ;
    rdfs:range xsd:string ;
    rdfs:comment "The officer as written in the source, e.g. 'Capt. Frederick Anstruther Herbert'."@en .

# --- draft.3 (2026-10-09): station deployment (decision of 10/9) ---
:StationDeployment a owl:Class ;
    rdfs:subClassOf crm:E7_Activity ;
    rdfs:label "Station deployment"@en ;
    rdfs:comment "v2 (2026-10-09): the station or sea area a ship was sent to, as stated with a commissioning or a command appointment ('Commissioned ... for the Channel squadron, later to the Mediterranean', 'on 1.7.1865 under Capt. ..., in the Mediterranean'). The station is a crm:E53_Place distinct from the place of the commissioning (crm:P7 of the commissioning). The label of the place is the wording of the source; grouping the wordings into historical stations is a separate table, not part of the graph. Several deployments stated in one sentence are ordered by :station_order ('then', 'later'); deployments of the same order are simultaneous ('for the Downs and North Sea'). 'On same station' is resolved to the previous deployment of the ship and marked with :review_note. Purposes alone (Naval Review, Spanish Armament, surveying), destinations of a voyage, the names of squadrons that are not sea areas (Flying Squadron), and the posts of coastguard ships and mail packets (roles, recorded as the role of the ship; decision of 10/9) are not recorded."@en .

:has_station_deployment a owl:ObjectProperty ;
    rdfs:domain crm:E7_Activity ;
    rdfs:range :StationDeployment ;
    rdfs:label "has station deployment"@en ;
    rdfs:comment "From the commissioning or command appointment that states the station, to the deployment."@en .

:station_order a owl:DatatypeProperty ;
    rdfs:domain :StationDeployment ;
    rdfs:range xsd:integer ;
    rdfs:comment "Order of the deployments stated in one sentence (1 = the first station; 'then' / 'later' starts the next)."@en .

:StationType a owl:Class ;
    rdfs:subClassOf crm:E55_Type ;
    rdfs:label "Station type"@en .
:SeaStation a owl:NamedIndividual , :StationType ;
    rdfs:label "sea station or area"@en ;
    rdfs:comment "A naval station or sea area ('Mediterranean', 'west coast of Africa', 'the Downs')."@en .
