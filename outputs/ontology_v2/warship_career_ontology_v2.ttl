    rdfs:comment "A mobilised unit used to support a diplomatic démarche, fulfilling a deterrent role, although the term is imprecise."@en ;
    dcterms:source "Winfield, Rif. British Warships in the Age of Sail, 1817–1863: Design, Construction, Careers and Fates."@en .
:DepotShip a owl:NamedIndividual , :ShipRole .
:DivisionalShip a owl:NamedIndividual , :ShipRole .
:EngineersTrainingShip a owl:NamedIndividual , :ShipRole .
:Flagship a owl:NamedIndividual , :ShipRole .
:FloatingBarracks a owl:NamedIndividual , :ShipRole .
:GuardShip a owl:NamedIndividual , :ShipRole .
:GunneryTrainingShip a owl:NamedIndividual , :ShipRole .
:HospitalShip a owl:NamedIndividual , :ShipRole .
:Hulk a owl:NamedIndividual , :ShipRole .
:Lazarette a owl:NamedIndividual , :ShipRole ;
    rdfs:comment "Definition not reproduced here for copyright reasons; see Winfield 2014, Glossary and Abbreviations."@en ;
    dcterms:source "Winfield, Rif. British Warships in the Age of Sail, 1817–1863: Design, Construction, Careers and Fates."@en .
:PowderHulk a owl:NamedIndividual , :ShipRole ;
    rdfs:comment "Definition not reproduced here for copyright reasons; see Winfield 2014, Glossary and Abbreviations."@en ;
    dcterms:source "Winfield, Rif. British Warships in the Age of Sail, 1817–1863: Design, Construction, Careers and Fates."@en .
:PowderMagazine a owl:NamedIndividual , :ShipRole .
:PrisonShip a owl:NamedIndividual , :ShipRole .
:ReceivingHulk a owl:NamedIndividual , :ShipRole .
:ReceivingShip a owl:NamedIndividual , :ShipRole ;
    rdfs:comment "Definition not reproduced here for copyright reasons; see Winfield 2014, Glossary and Abbreviations."@en ;
    dcterms:source "Winfield, Rif. British Warships in the Age of Sail, 1817–1863: Design, Construction, Careers and Fates."@en .
:SheerHulk a owl:NamedIndividual , :ShipRole ;
    rdfs:comment "Definition not reproduced here for copyright reasons; see Winfield 2014, Glossary and Abbreviations."@en ;
    dcterms:source "Winfield, Rif. British Warships in the Age of Sail, 1817–1863: Design, Construction, Careers and Fates."@en .
:Tender a owl:NamedIndividual , :ShipRole .
:TrainingShip a owl:NamedIndividual , :ShipRole .
:TroopTransport a owl:NamedIndividual , :ShipRole .
:TurretShip a owl:NamedIndividual , :ShipRole .
:VictuallingDepot a owl:NamedIndividual , :ShipRole .
:VictuallingVessel a owl:NamedIndividual , :ShipRole .

# Individuals of :ShipType
:BrigSloop a owl:NamedIndividual , :ShipType ; rdfs:label "Brig Sloop"@en .
:CoastalDefenceShip a owl:NamedIndividual , :ShipType ; rdfs:label "Coastal Defence Ship"@en .
:Cutter a owl:NamedIndividual , :ShipType ; rdfs:label "Cutter"@en .
:Frigate a owl:NamedIndividual , :ShipType ; rdfs:label "Frigate"@en .
:Gunboat a owl:NamedIndividual , :ShipType ; rdfs:label "Gunboat"@en .
