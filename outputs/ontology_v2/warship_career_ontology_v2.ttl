:MiscShip a owl:NamedIndividual , :ShipType ; rdfs:label "Miscellaneous Vessel"@en .
:PaddleFrigate a owl:NamedIndividual , :ShipType ; rdfs:label "Paddle Frigate"@en .
:PaddleSloop a owl:NamedIndividual , :ShipType ; rdfs:label "Paddle Sloop"@en .
